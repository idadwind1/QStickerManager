<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QStickerManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QStickerManager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              Padding="16"
              ColumnDefinitions="*,Auto,Auto">

            <AutoSuggestBox
                Grid.Column="0"
                PlaceholderText="Search stickers..."
                QueryIcon="Find" />

            <Button
                Grid.Column="1"
                Margin="12,0,0,0"
                Content="Import" />

            <Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Content="Export" />

        </Grid>

        <!-- Categories -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled">

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Padding="16,0,16,12">

                <ToggleButton Content="Recent" IsChecked="True"/>
                <ToggleButton Content="Favorites"/>
                <ToggleButton Content="Packs"/>
                <ToggleButton Content="Emoji"/>
                <ToggleButton Content="Animals"/>
                <ToggleButton Content="Gaming"/>
                <ToggleButton Content="Reactions"/>

            </StackPanel>

        </ScrollViewer>

        <!-- Sticker Grid -->
        <ScrollViewer Grid.Row="2">

            <ItemsControl>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Sample Items -->
                <Button Width="96" Height="96" Margin="4">
                    <Border CornerRadius="12">
                        <Image Source="Assets/placeholder.png"/>
                    </Border>
                </Button>

                <Button Width="96" Height="96" Margin="4">
                    <Border CornerRadius="12">
                        <Image Source="Assets/placeholder.png"/>
                    </Border>
                </Button>

                <Button Width="96" Height="96" Margin="4">
                    <Border CornerRadius="12">
                        <Image Source="Assets/placeholder.png"/>
                    </Border>
                </Button>

            </ItemsControl>

        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Grid Grid.Row="3"
              Padding="16"
              ColumnDefinitions="*,Auto,Auto">

            <TextBlock
                VerticalAlignment="Center"
                Text="Selected: None" />

            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Text="0 × 0" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="0 KB" />

        </Grid>

    </Grid>
</Window>